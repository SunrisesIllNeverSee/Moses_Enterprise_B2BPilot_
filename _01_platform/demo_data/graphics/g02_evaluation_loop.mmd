    IV["INTERVENE<br/>━━━━━━━━━━━━━━<br/>INPUTS: diagnoses,<br/>intervention catalog,<br/>customer decisions<br/>OUTPUTS: applied interventions,<br/>control assignments<br/>━━━<br/>Day 21"]
