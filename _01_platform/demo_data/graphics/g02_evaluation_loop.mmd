    EV["EVALUATE<br/>━━━━━━━━━━━━━━<br/>INPUTS: raw telemetry,<br/>Micro Evals, sessions<br/>OUTPUTS: operator baselines,<br/>system baselines, metric vectors<br/>━━━<br/>Days 1-14"]
    BM["BENCHMARK<br/>━━━━━━━━━━━━━━<br/>INPUTS: baselines,<br/>reference field, cohort<br/>OUTPUTS: percentiles,<br/>divergence scores, peer comp<br/>━━━<br/>Days 7-16"]
